rules_version = '2';
// Reglas de seguridad. Se pegan en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Textos de la web (bio, redes, contacto…): los lee cualquiera, solo Dani los cambia.
    match /site/{doc} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Trabajos del portfolio: el público solo ve los marcados como visibles.
    match /works/{id} {
      allow read: if resource.data.visible == true || esAdmin();
      allow write: if esAdmin();
    }

    // Mensajes del formulario de contacto: cualquiera puede enviar uno, solo Dani los lee.
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nombre','email','tipo','fecha','presupuesto','mensaje','leido','createdAt'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.mensaje is string && request.resource.data.mensaje.size() > 0 && request.resource.data.mensaje.size() <= 5000
        && request.resource.data.tipo is string && request.resource.data.tipo.size() <= 80
        && request.resource.data.fecha is string && request.resource.data.fecha.size() <= 20
        && request.resource.data.presupuesto is string && request.resource.data.presupuesto.size() <= 80
        && request.resource.data.leido == false
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if esAdmin();
    }

    // Zona privada: solo Dani desde el panel. Los invitados nunca leen esto directamente;
    // los vídeos se les sirven a través de la función /api/acceso-privado.
    match /privateVideos/{id} { allow read, write: if esAdmin(); }
    match /accessCodes/{id}   { allow read, write: if esAdmin(); }
    match /invites/{id}       { allow read, write: if esAdmin(); }

    // Estadísticas de visitas: las escribe el servidor; solo Dani las lee.
    match /stats/{dia} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // Lista de administradores: se crea a mano en la consola (paso de la guía).
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
